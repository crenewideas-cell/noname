# Copy to .env. The same build ID must be supplied when building the web client.
# Replace this example IP with your server IP; no domain or certificate needed.
# If PUBLIC_PORT is not 80, include the same port in PUBLIC_ORIGIN.
PUBLIC_PORT=80
PUBLIC_ORIGIN=http://192.0.2.10
ONLINE_BUILD_ID=online-packs-v2
MATCH_REGION=default
RESUME_GRACE_MS=120000
ONLINE_MAINTENANCE=0
# Optional read-only status endpoint token. Keep this outside the repository.
ADMIN_STATUS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STATUS_TOKEN
# Use a long random hex password (URL-safe) and keep .env private.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_HEX_PASSWORD
MAX_GAME_INSTANCES=2
PLATFORM_MEMORY=3g
PLATFORM_CPUS=2
# Test only: set to 1 to give each browser window its own session token.
ALLOW_MULTI_OPEN=0
